# Environment Configuration

# Application
APP_NAME=Cleo Financial Assistant
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://cleo:cleo_password@localhost:5432/cleo_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Plaid API (Sign up at https://plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# OpenAI API (for chat service)
OPENAI_API_KEY=your_openai_api_key

# Anthropic API (alternative for chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (for email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@cleo.ai

# Firebase (for push notifications)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Monitoring
SENTRY_DSN=your_sentry_dsn

# Partner Bank APIs (when ready)
PARTNER_BANK_API_KEY=
PARTNER_BANK_API_SECRET=

# Credit Bureau APIs (when ready)
EXPERIAN_API_KEY=
EQUIFAX_API_KEY=
TRANSUNION_API_KEY=
